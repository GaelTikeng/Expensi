# ─── Client (bundled into the app; must be safe to expose) ───────────────────
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Production API origin (EAS Hosting). Leave empty in dev; Metro serves routes.
EXPO_PUBLIC_API_URL=
# Optional: Sentry DSN for client crash reporting (F7.5)
EXPO_PUBLIC_SENTRY_DSN=

# ─── Server only (Expo API Routes / EAS Hosting env) ─────────────────────────
# Neon: pooled URL for runtime, direct URL for drizzle-kit migrate.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/expense?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/expense?sslmode=require

CLERK_SECRET_KEY=sk_test_xxx
# Clerk Dashboard → Webhooks → endpoint <API_URL>/api/webhooks/clerk, events user.created/updated/deleted
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# TensorX via the OpenAI SDK
TENSORX_API_KEY=
TENSORX_BASE_URL=https://api.tensorx.ai/v1
# Override after checking GET /v1/models
TENSORX_MODEL_EXTRACT=z-ai/glm-5.3-flash
TENSORX_MODEL_NARRATIVE=z-ai/glm-5.3

# S3 (private bucket). S3_ENDPOINT only for S3-compatible providers.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=xpens-ia-files
S3_REGION=eu-central-1
S3_ENDPOINT=

# AI quotas per user per month (F7.6)
AI_QUOTA_EXTRACT_PER_MONTH=50
AI_QUOTA_NARRATIVE_PER_MONTH=120

# Enables POST /api/maintenance/sweep (cron). Any long random string.
MAINTENANCE_SECRET=
